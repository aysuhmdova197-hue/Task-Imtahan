@model Chef
@{
    ViewData["Title"] = "Create";
}

<main>
    <div class="Container" style="margin-left:250px">
        <form methods="post" asp-action="Create">
            <div class="mb-3">
                <label for="exampleInputEmail1" class="form-label">Image</label>
                <input asp-for="Image" type="text class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp">
                <span asp-validation-for="Image" class="label label-important"></span>
            </div>
            <div class="mb-3">
                <label for="exampleInputPassword1" class="form-label">Name</label>
                <input asp-for="Name" type="text" class="form-control" id="exampleInputPassword1">
                <span asp-validation-for="Name" class="label label-important"></span>

            </div>
            <div class="mb-3">
                <label for="exampleInputPassword1" class="form-label">Job</label>
                <input asp-for="Job" type="text" class="form-control" id="exampleInputPassword1">
                <span asp-validation-for="Job" class="label label-important"></span>

            </div>

            <button type="submit" class="btn btn-primary">Submit</button>
            <a asp-action="Index" class="btn-btn-ligth">Cancel</a>
        </form>
    </div>
</main>
